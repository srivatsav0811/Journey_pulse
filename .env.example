# Copy to .env (never commit it) or set these in your terminal before starting the server.
# Without a key the advisor runs as the offline analyst.
# Set ONE of these. If both are set, Claude is used unless ADVISOR_PROVIDER=groq.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional: pick the model / provider
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ADVISOR_PROVIDER=groq
PORT=8000
